{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "bai-it-support",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "bai-it-support-attachments"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bai-it-support-kpi-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "./migrations"
    }
  ]
}
